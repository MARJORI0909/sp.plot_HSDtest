class(genotype)
class(irrigation)
factor(genotype)
factor(irrigation)

#Homogeneity of variance test
leveneTest(data_yield$yield,interaction(data_yield$fertilización,data_yield$variedad),
           center=median)

#Including interaction
anva1<-aov(yield~irrigation*genotype,data=data_yield)
anova(anva1)

#Normality test 
aov_residuals <- residuals(object = anva1)
shapiro.test(x=aov_residuals)

#Coefficient of variation (CV)
anova_chart<-anova(anva1)
CMerror <- anova_chart["Residuals", "Mean Sq"]
mean <- mean(data_yield$yield)
CV <- (sqrt(CMerror) / mean) * 100
CV

anva1$coefficients
